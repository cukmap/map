// Cloudflare Workers 설정 — 빌드: python3 tools/build.py → dist/
{
  "name": "cukmap-map",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  // 실내 데이터(비공개 저장소 cukmap/indoor 에서 배포되는 Worker)
  "services": [{ "binding": "INDOOR", "service": "cukmap-indoor" }]
}
